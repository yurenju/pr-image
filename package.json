{
  "name": "@yurenju/pr-image",
  "version": "0.1.2",
  "description": "Upload an image to Cloudflare R2 and print a URL to paste into a pull request",
  "license": "MIT",
  "author": "Yuren Ju (yurenju)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yurenju/pr-image.git"
  },
  "type": "module",
  "bin": {
    "pr-image": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "test": "node --test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@1password/sdk": "^0.5.0",
    "aws4fetch": "^1.0.20"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
