{
  "compilerOptions": {
    "lib": ["esnext"],
    "types": ["node"],
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,

    // aws4fetch's declarations reference DOM globals. Pulling in the whole DOM
    // lib to satisfy them would also hide Node-specific mistakes in our code.
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
